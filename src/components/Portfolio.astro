---
import { contato, conteudo, linkWhatsapp, type Idioma } from '../data/conteudo';

interface Props {
  idioma: Idioma;
}

const t = conteudo[Astro.props.idioma];
const atividade = 'https://www.linkedin.com/in/allan-lopreti/recent-activity/all/';
const recomendacoes = 'https://www.linkedin.com/in/allan-lopreti/details/recommendations/';
---

<section class="heroi">
  <div class="container heroi__grade">
    <div class="heroi__texto">
      <p class="heroi__saudacao">{t.heroi.saudacao}</p>
      <h1>Allan Lopreti</h1>
      <p class="heroi__cargo">{t.heroi.cargo}</p>
      <p class="heroi__sub">{t.heroi.texto}</p>
      <div class="botoes">
        <a class="botao botao--primario" href="#contato">{t.heroi.contato}</a>
        <a class="botao" href="#garagemaqui">{t.heroi.garagemAqui}</a>
      </div>
      <ul class="redes">
        <li>
          <a href={contato.linkedin} rel="noopener" target="_blank" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={contato.github} rel="noopener" target="_blank" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.03c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.64 1.66.23 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3Z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={`mailto:${contato.email}`} aria-label={t.contatoSecao.rotulos.email}>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="traco">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={linkWhatsapp(t.contatoSecao.mensagemWhatsapp)} rel="noopener" target="_blank" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.58-.35ZM12.04 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.72.97 1-3.62-.24-.37a9.8 9.8 0 0 1-1.5-5.22c0-5.42 4.42-9.83 9.84-9.83 2.63 0 5.1 1.03 6.96 2.89a9.78 9.78 0 0 1 2.88 6.95c0 5.42-4.42 9.83-9.85 9.83Zm8.38-18.2A11.77 11.77 0 0 0 12.04.13C5.5.13.18 5.45.18 11.98c0 2.09.55 4.13 1.59 5.93L.08 24l6.24-1.64a11.84 11.84 0 0 0 5.71 1.46h.01c6.54 0 11.86-5.32 11.86-11.86 0-3.17-1.23-6.15-3.48-8.39Z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
    <div class="heroi__foto">
      <img src="/allan-lopreti.jpg" alt="Allan Lopreti" width="400" height="400" fetchpriority="high" />
      <span class="heroi__local">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="traco">
          <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"></path>
          <circle cx="12" cy="9.5" r="2.5"></circle>
        </svg>
        {t.heroi.local}
      </span>
    </div>
  </div>
  <div class="container">
    <ul class="numeros">
      {
        t.numeros.map(({ valor, rotulo }) => (
          <li>
            <strong>{valor}</strong>
            <span>{rotulo}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="secao secao--alt" id="sobre">
  <div class="container sobre">
    <h2 class="secao__titulo">{t.sobre.titulo}</h2>
    <div class="sobre__texto">
      {t.sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
    </div>
  </div>
</section>

<section class="secao" id="garagemaqui">
  <div class="container">
    <div class="garagem">
      <div class="garagem__texto">
        <span class="rotulo">{t.garagemAqui.rotulo}</span>
        <h2 class="secao__titulo">
          <img src="/garagemaqui.png" alt="" width="44" height="44" />
          {t.garagemAqui.titulo}
        </h2>
        <p class="garagem__sub">{t.garagemAqui.texto}</p>
        <ul class="garagem__pontos">
          {t.garagemAqui.pontos.map((ponto) => <li>{ponto}</li>)}
        </ul>
        <a class="botao botao--garagem" href={contato.garagemAqui} rel="noopener" target="_blank">{t.garagemAqui.link} ↗</a>
      </div>
    </div>
  </div>
</section>

<section class="secao secao--alt" id="experiencia">
  <div class="container">
    <h2 class="secao__titulo">{t.experiencia.titulo}</h2>
    <ol class="linha">
      {
        t.experiencia.itens.map((item) => (
          <li class:list={['linha__item', { 'linha__item--destaque': item.destaque }]}>
            <div class="linha__cabeca">
              <h3>{item.cargo}</h3>
              <span class="linha__periodo">{item.periodo}</span>
            </div>
            <p class="linha__empresa">
              {item.empresa} · {item.local}
            </p>
            <p>{item.resumo}</p>
            {item.pontos.length > 0 && (
              <ul class="linha__pontos">
                {item.pontos.map((ponto) => (
                  <li>{ponto}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="secao" id="projetos">
  <div class="container">
    <h2 class="secao__titulo">{t.projetos.titulo}</h2>
    <p class="secao__texto">{t.projetos.texto}</p>
    <div class="projetos">
      {
        t.projetos.itens.map((projeto) => (
          <article class="cartao projeto">
            <div class="projeto__cabeca">
              {projeto.imagem ? (
                <img src={projeto.imagem} alt="" width="40" height="40" />
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="traco projeto__icone">
                  <path d="m8 6-6 6 6 6M16 6l6 6-6 6" />
                </svg>
              )}
              <h3>{projeto.nome}</h3>
            </div>
            <p>{projeto.descricao}</p>
            <ul class="tags">
              {projeto.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a href={projeto.link} rel="noopener" target="_blank">
              {projeto.rotuloLink} ↗
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="secao secao--alt" id="competencias">
  <div class="container">
    <h2 class="secao__titulo">{t.competencias.titulo}</h2>
    <div class="competencias">
      {
        t.competencias.grupos.map((grupo) => (
          <div>
            <h3>{grupo.nome}</h3>
            <ul class="tags">
              {grupo.itens.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="secao">
  <div class="container duas">
    <div class="cartao">
      <h2 class="secao__titulo">{t.escrita.titulo}</h2>
      <p class="secao__texto">{t.escrita.texto}</p>
      <ul class="temas">
        {t.escrita.temas.map((tema) => <li>{tema}</li>)}
      </ul>
      <a href={atividade} rel="noopener" target="_blank">{t.escrita.link} ↗</a>
    </div>
    <figure class="cartao recomendacao">
      <h2 class="secao__titulo">{t.recomendacao.titulo}</h2>
      <blockquote>“{t.recomendacao.texto}”</blockquote>
      <figcaption>
        <strong>{t.recomendacao.autor}</strong>
        <span>{t.recomendacao.cargo}</span>
        <a href={recomendacoes} rel="noopener" target="_blank">{t.recomendacao.link} ↗</a>
      </figcaption>
    </figure>
  </div>
</section>

<section class="secao secao--alt" id="formacao">
  <div class="container">
    <h2 class="secao__titulo">{t.formacao.titulo}</h2>
    <div class="formacao">
      {
        t.formacao.itens.map((item) => (
          <div class="cartao">
            <h3>{item.nome}</h3>
            <p class="linha__empresa">{item.instituicao}</p>
            <p class="linha__periodo">{item.periodo}</p>
          </div>
        ))
      }
    </div>
    <p class="formacao__extra">{t.formacao.idiomas}</p>
    <p class="formacao__extra">{t.formacao.certificados}</p>
  </div>
</section>

<section class="secao" id="contato">
  <div class="container">
    <div class="contato">
      <h2 class="secao__titulo">{t.contatoSecao.titulo}</h2>
      <p class="secao__texto">{t.contatoSecao.texto}</p>
      <ul class="contato__lista">
        <li>
          <span>LinkedIn</span>
          <a href={contato.linkedin} rel="noopener" target="_blank">in/allan-lopreti</a>
        </li>
        <li>
          <span>GitHub</span>
          <a href={contato.github} rel="noopener" target="_blank">allanlopreti</a>
        </li>
        <li>
          <span>{t.contatoSecao.rotulos.email}</span>
          <a href={`mailto:${contato.email}`}>{contato.email}</a>
        </li>
        <li>
          <span>{t.contatoSecao.rotulos.garagemAqui}</span>
          <a href={`mailto:${contato.emailGaragemAqui}`}>{contato.emailGaragemAqui}</a>
        </li>
        <li>
          <span>{t.contatoSecao.rotulos.whatsapp}</span>
          <a href={linkWhatsapp(t.contatoSecao.mensagemWhatsapp)} rel="noopener" target="_blank">{contato.whatsappFormatado}</a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .traco {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Herói */
  .heroi {
    padding: clamp(32px, 8vw, 80px) 0 clamp(40px, 8vw, 72px);
  }

  .heroi__grade {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .heroi__foto {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .heroi__foto img {
    width: clamp(112px, 32vw, 160px);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--superficie);
    box-shadow: 0 0 0 2px var(--destaque), var(--sombra);
  }

  .heroi__local {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--suave);
    font-size: 0.9rem;
  }

  .heroi__local svg {
    width: 16px;
    height: 16px;
  }

  .heroi__saudacao {
    color: var(--suave);
    font-weight: 500;
  }

  h1 {
    font-size: clamp(2.3rem, 10vw, 4rem);
    letter-spacing: -0.02em;
  }

  .heroi__cargo {
    margin: 8px 0 16px;
    color: var(--destaque);
    font-size: clamp(1rem, 3.6vw, 1.2rem);
    font-weight: 600;
  }

  .heroi__sub {
    max-width: 580px;
    margin-bottom: 28px;
    color: var(--suave);
    font-size: clamp(1.05rem, 3.6vw, 1.2rem);
  }

  .heroi .botoes .botao {
    flex: 1 1 200px;
  }

  .redes {
    display: flex;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .redes a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--borda);
    border-radius: 12px;
    background: var(--superficie);
    color: var(--texto);
  }

  .redes a:hover {
    border-color: var(--destaque);
    color: var(--destaque);
  }

  .redes svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .redes svg.traco {
    fill: none;
  }

  .numeros {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: clamp(40px, 8vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  .numeros li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    background: var(--superficie);
  }

  .numeros strong {
    color: var(--destaque);
    font-size: clamp(1.4rem, 6vw, 2rem);
    line-height: 1.1;
  }

  .numeros span {
    color: var(--suave);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  @media (max-width: 520px) {
    .numeros {
      grid-template-columns: 1fr;
    }

    .numeros li {
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
    }

    .numeros strong {
      min-width: 2.2ch;
    }
  }

  @media (min-width: 860px) {
    .heroi__grade {
      grid-template-columns: 1fr auto;
      gap: 48px;
    }

    .heroi__foto {
      order: 0;
      align-items: center;
    }

    .heroi__foto img {
      width: 280px;
    }

    .heroi .botoes .botao {
      flex: 0 0 auto;
    }
  }

  /* Sobre */
  .sobre__texto {
    display: grid;
    gap: 16px;
    max-width: 720px;
    color: var(--suave);
    font-size: 1.05rem;
  }

  @media (min-width: 860px) {
    .sobre {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 48px;
    }
  }

  /* GaragemAqui */
  .garagem {
    padding: clamp(24px, 6vw, 48px);
    border-radius: 24px;
    background: linear-gradient(135deg, #1d4fd7, var(--garagem) 55%, #5aa0ff);
    color: #fff;
    box-shadow: var(--sombra);
  }

  .garagem .rotulo {
    background: rgb(255 255 255 / 0.18);
    color: #fff;
  }

  .garagem .secao__titulo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .garagem .secao__titulo img {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #fff;
  }

  .garagem__sub {
    max-width: 640px;
    margin-bottom: 20px;
    color: rgb(255 255 255 / 0.9);
    font-size: 1.1rem;
  }

  .garagem__pontos {
    display: grid;
    gap: 10px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .garagem__pontos li {
    position: relative;
    padding-left: 28px;
  }

  .garagem__pontos li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
  }

  .botao--garagem {
    border-color: #fff;
    background: #fff;
    color: #1d4fd7;
  }

  @media (min-width: 860px) {
    .garagem__pontos {
      grid-template-columns: 1fr 1fr;
      gap: 14px 32px;
    }
  }

  /* Experiência */
  .linha {
    display: grid;
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .linha__item {
    position: relative;
    padding: 0 0 0 28px;
  }

  .linha__item::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 10px;
    bottom: -26px;
    width: 2px;
    background: var(--borda);
  }

  .linha__item:last-child::before {
    display: none;
  }

  .linha__item::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 14px;
    border: 3px solid var(--destaque);
    border-radius: 50%;
    background: var(--fundo);
  }

  .linha__item--destaque::after {
    border-color: var(--garagem);
    background: var(--garagem);
  }

  .linha__item h3 {
    font-size: 1.1rem;
  }

  .linha__cabeca {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }

  .linha__periodo {
    color: var(--suave);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .linha__empresa {
    margin-bottom: 6px;
    color: var(--destaque);
    font-weight: 600;
  }

  .linha__pontos {
    margin: 8px 0 0;
    padding-left: 18px;
    color: var(--suave);
  }

  .linha__pontos li + li {
    margin-top: 4px;
  }

  .linha__item + .linha__item {
    padding-top: 16px;
  }

  .linha__item + .linha__item::after {
    top: 22px;
  }

  .linha__item + .linha__item::before {
    top: 26px;
  }

  /* Projetos */
  .projetos {
    display: grid;
    gap: 16px;
  }

  .projeto {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .projeto > p {
    flex: 1;
    color: var(--suave);
  }

  .projeto > a {
    font-weight: 600;
    text-decoration: none;
  }

  .projeto__cabeca {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .projeto__cabeca img,
  .projeto__icone {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }

  .projeto__icone {
    padding: 8px;
    background: var(--destaque-fundo);
    color: var(--destaque);
  }

  .projeto h3 {
    font-size: 1.15rem;
  }

  @media (min-width: 700px) {
    .projetos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .projetos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Competências */
  .competencias {
    display: grid;
    gap: 24px;
    margin-top: 24px;
  }

  .competencias h3 {
    margin-bottom: 10px;
    color: var(--suave);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (min-width: 700px) {
    .competencias {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 40px;
    }
  }

  /* Escrita e recomendação */
  .duas {
    display: grid;
    gap: 16px;
  }

  .duas .secao__titulo {
    font-size: clamp(1.35rem, 4.5vw, 1.7rem);
  }

  .duas .secao__texto {
    margin-bottom: 16px;
  }

  .duas a {
    font-weight: 600;
    text-decoration: none;
  }

  .temas {
    display: grid;
    gap: 10px;
    margin: 0 0 20px;
    padding-left: 18px;
  }

  .recomendacao {
    margin: 0;
  }

  .recomendacao blockquote {
    margin: 0 0 20px;
    font-size: 1.1rem;
    font-style: italic;
  }

  .recomendacao figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .recomendacao figcaption span {
