---
import '../styles/global.css';
import { conteudo, type Idioma } from '../data/conteudo';

interface Props {
  idioma: Idioma;
  titulo?: string;
  /** A 404 não entra no Google. */
  indexar?: boolean;
}

const { idioma, titulo, indexar = true } = Astro.props;
const t = conteudo[idioma];
const inicio = t.caminho;
const tituloCompleto = titulo ? `${titulo} · Allan Lopreti` : t.titulo;
const canonica = new URL(t.caminho, Astro.site);
const imagem = new URL('/allan-lopreti.jpg', Astro.site);
const ano = new Date().getFullYear();
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={t.descricao} />
    {
      indexar ? (
        <>
          <link rel="canonical" href={canonica} />
          <link rel="alternate" hreflang="pt-BR" href={new URL('/', Astro.site)} />
          <link rel="alternate" hreflang="en" href={new URL('/en', Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/allan-lopreti.jpg" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:site_name" content="Allan Lopreti" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={t.descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagem} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      try {
        const salvo = localStorage.getItem('tema');
        if (salvo === 'claro' || salvo === 'escuro') document.documentElement.dataset.tema = salvo;
      } catch {}
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">{t.pular}</a>

    <header class="topo">
      <div class="container topo__barra">
        <a class="marca" href={inicio} aria-label="Allan Lopreti">
          <span class="marca__sigla" aria-hidden="true">AL</span>
        </a>
        <nav class="menu" aria-label={idioma === 'pt' ? 'Seções' : 'Sections'}>
          {t.menu.map(({ href, rotulo }) => <a href={`${inicio === '/' ? '' : inicio}${href}`}>{rotulo}</a>)}
        </nav>
        <div class="acoes">
          <a class="acao" href={t.outroIdioma.href} hreflang={idioma === 'pt' ? 'en' : 'pt-BR'} aria-label={t.outroIdioma.nome}>
            {t.outroIdioma.rotulo}
          </a>
          <button class="acao" type="button" id="tema" data-claro={t.tema.claro} data-escuro={t.tema.escuro} aria-label={t.tema.escuro}>
            <svg class="icone-lua" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            <svg class="icone-sol" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="container rodape__barra">
        <span>© {ano} · {t.rodape}</span>
        <a href={t.outroIdioma.href} hreflang={idioma === 'pt' ? 'en' : 'pt-BR'}>{t.outroIdioma.nome}</a>
      </div>
    </footer>

    <script>
      const botao = document.getElementById('tema') as HTMLButtonElement;
      const raiz = document.documentElement;
      const escuroDoSistema = matchMedia('(prefers-color-scheme: dark)');
      const escuro = () => (raiz.dataset.tema ? raiz.dataset.tema === 'escuro' : escuroDoSistema.matches);
      const rotular = () => botao.setAttribute('aria-label', escuro() ? botao.dataset.claro! : botao.dataset.escuro!);

      rotular();
      escuroDoSistema.addEventListener('change', rotular);
      botao.addEventListener('click', () => {
        const novo = escuro() ? 'claro' : 'escuro';
        raiz.dataset.tema = novo;
        try {
          localStorage.setItem('tema', novo);
        } catch {}
        rotular();
      });
    </script>
  </body>
</html>
